{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist/frontend/browser"
      }
    },
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.js" },
    { "src": "/assets/(.*)", "dest": "frontend/dist/frontend/browser/assets/$1" },
    { "src": "/(.*\\.[a-zA-Z0-9]+)", "dest": "frontend/dist/frontend/browser/$1" },
    { "src": "/(.*)", "dest": "frontend/dist/frontend/browser/index.html" }
  ]
}